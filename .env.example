# ============================================================
# OKGS — environment configuration
# Copy to `.env` (or set in your host) and fill in.
# ============================================================

# ------------------------------------------------------------
# BACKEND — Neon serverless Postgres (production data layer)
# ------------------------------------------------------------
# Point any ONE of these at your Neon connection string and the
# site automatically switches from the mock (in-memory, seeded)
# backend to real serverless Postgres. Tables are created and
# seeded on first request. No extra npm dependency is needed —
# the adapter speaks Neon's serverless HTTP protocol directly.
#
#   NEON_DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
NEON_DATABASE_URL=
# Vite-style names are honoured too (Vite exposes VITE_* to the client;
# this app reads them server-side the same way):
VITE_NEON_DATABASE_URL=
# Generic fallback (only used when it starts with postgres:// —
# a file: URL like Prisma's is ignored):
DATABASE_URL=

# ------------------------------------------------------------
# ADMIN — seed password for the Studio (#/admin)
# ------------------------------------------------------------
# The studio password lives IN the database as a sha-256 hash
# (kv.admin_hash). ADMIN_KEY only seeds that hash on first run;
# after signing in, rotate it from the studio itself.
ADMIN_KEY=genesis2026
